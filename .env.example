# ---------------------------------------------------------------------------
# The ONLY secrets. Set these three in Vercel (Project > Settings >
# Environment Variables) and in .env.local for local dev. Never commit them.
# Firebase console > Project Settings > Service Accounts > Generate new key.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=itzhoyoo-bc993
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@itzhoyoo-bc993.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Optional. The Firebase web config (API key, bucket, app id...) is public and
# now lives in lib/firebase-config.js, so FIREBASE_WEB_API_KEY and
# FIREBASE_STORAGE_BUCKET are no longer needed. Set them only to override.
# ---------------------------------------------------------------------------
# Used to build the password-reset link's continue URL.
NEXT_PUBLIC_APP_URL=https://your-deployed-domain.com

# Optional: secret used to sign login cookies. If unset, it's derived from FIREBASE_PRIVATE_KEY.
# SESSION_SECRET=any-long-random-string

# ---------------------------------------------------------------------------
# Video storage. While Firebase Storage isn't set up, videos (posts, stories,
# video ads) go to Supabase Storage instead. The private "videos" bucket is
# created automatically on the first upload.
#   - The project URL and publishable key are public and live in
#     lib/supabase-config.js, so the SECRET key is the only var to set.
#   - Supabase dashboard > Project Settings > API Keys.
#   - SUPABASE_SECRET_KEY is server-only: never give it a NEXT_PUBLIC_ name.
#   - Remove it (or set STORAGE_PROVIDER=firebase) to go back to Firebase.
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# STORAGE_PROVIDER=supabase
