# ── Sitevento (OPTIONAL: defaults are hardcoded in lib/sitevento.ts; env vars override) ──
# Create in Sitevento → /dashboard/api. Use an sv_test_ key first (kept out of real analytics).
SITEVENTO_API_KEY=sv_test_xxxxxxxxxxxxxxxx
SITEVENTO_API_URL=https://sitevento12.vercel.app
# Optional if you only have one connected site; needed if you have several.
SITEVENTO_SITE_ID=jA3c3bsLx8AlgD6EL71B

# ── Firebase Admin (server-only; for real signups) ───────────────────────
# From your Firebase service account JSON (Project Settings → Service accounts → Generate new key).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value exactly, including \n for line breaks, wrapped in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# No client-side Firebase config needed — there is no real login/session in
# this app. Signup is Admin-SDK-only (server-side); the browser just keeps
# the returned { uid, name, email } in localStorage to attach demo events to.
