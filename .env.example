# Firebase Admin SDK (service account) — Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Web API key — Project Settings > General > Web API Key.
# This is NOT a secret (it only identifies the Firebase project), but the
# Admin SDK alone cannot verify a password or issue an ID token, so our
# server calls Google's Identity Toolkit REST API directly with this key
# to do that step without ever loading the Firebase client SDK.
FIREBASE_WEB_API_KEY=AIzaSy...

# Used to build the password-reset link's continue URL. Optional.
NEXT_PUBLIC_APP_URL=https://your-deployed-domain.com
