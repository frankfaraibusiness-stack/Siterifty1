# ---------------------------------------------------------------------------
# The ONLY secrets. Set these three in Vercel (Project > Settings >
# Environment Variables) and in .env.local for local dev. Never commit them.
# Firebase console > Project Settings > Service Accounts > Generate new key.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=itzhoyoo-bc993
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@itzhoyoo-bc993.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Optional. The Firebase web config (API key, bucket, app id...) is public and
# now lives in lib/firebase-config.js, so FIREBASE_WEB_API_KEY and
# FIREBASE_STORAGE_BUCKET are no longer needed. Set them only to override.
# ---------------------------------------------------------------------------
# Used to build the password-reset link's continue URL.
NEXT_PUBLIC_APP_URL=https://your-deployed-domain.com
